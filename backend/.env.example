# Project Settings
PROJECT_NAME="Library Management System API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration (MySQL 8.4)
# Khuyến nghị: Sử dụng tài khoản riêng biệt thay vì root trên production
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=library

# Hoặc truyền trực tiếp chuỗi kết nối DATABASE_URL nếu dùng Docker / Cloud DB
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/library?charset=utf8mb4
DATABASE_URL=

# CORS Settings (cách nhau bởi dấu phẩy)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000"
